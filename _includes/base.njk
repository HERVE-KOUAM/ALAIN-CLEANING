<!doctype html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if title %}<title>{{ title }} — {{ site.name }} | Nettoyage GTA, Oshawa</title>{% else %}<title>{{ site.name }} | Nettoyage GTA, Oshawa</title>{% endif %}
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:type" content="{{ ogType or 'article' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="stylesheet" href="/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/flaticon.css">
  <link rel="stylesheet" href="/css/plugins.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    .site-header-blog{background:#0e2a47;padding:16px 0;position:relative;z-index:5}
    .site-header-blog .logo a{color:#fff;font-size:24px;font-weight:800;text-decoration:none;font-family:inherit}
    .site-header-blog .logo a span{color:#1ebba3}
    .site-header-blog .nav-blog{text-align:right}
    .site-header-blog .nav-blog a{color:#cfe3ee;margin-left:22px;text-decoration:none;font-weight:600;font-size:15px;transition:.2s}
    .site-header-blog .nav-blog a:hover{color:#1ebba3}
    .blog-hero{background:linear-gradient(90deg,#0e2a47 0%,#13a5b9 100%);padding:56px 0;color:#fff;text-align:center}
    .blog-hero h1{font-size:38px;font-weight:800;margin-bottom:8px;color:#fff}
    .blog-hero p{color:#d8eef4;max-width:640px;margin:0 auto;font-size:16px}
    .blog-body{padding:48px 0 70px;background:#f5f8fa}
    .blog-content{background:#fff;padding:44px;border-radius:10px;box-shadow:0 10px 34px rgba(14,42,71,.08);color:#3a4553;font-size:16.5px;line-height:1.85}
    .blog-content h2{color:#0e2a47;font-size:27px;margin:34px 0 14px}
    .blog-content h3{color:#0e2a47;font-size:21px;margin:26px 0 10px}
    .blog-content p{margin-bottom:16px}
    .blog-content ul,.blog-content ol{margin:0 0 18px 24px}
    .blog-content li{margin-bottom:8px}
    .blog-content img{max-width:100%;height:auto;border-radius:8px;margin:18px 0}
    .blog-content blockquote{border-left:4px solid #1ebba3;background:#eefcf9;padding:16px 22px;margin:22px 0;border-radius:0 8px 8px 0;font-style:italic;color:#0e2a47}
    .post-meta{color:#7c8a99;font-size:14px}
    .post-meta span{margin-right:16px}
    .post-meta i{color:#1ebba3;margin-right:5px}
    .blog-content a{color:#13a5b9;text-decoration:underline}
    .post-hero-img{width:100%;height:200px;object-fit:cover;border-radius:10px}
    .giscus{border-top:1px solid #e3ecf2;margin-top:38px;padding-top:26px}
    .back-link{display:inline-block;color:#0e2a47;font-weight:700;text-decoration:none;margin-bottom:26px;font-size:15px}
    .back-link i{margin-right:6px;color:#1ebba3}
  </style>
</head>
<body>
  <header class="site-header-blog">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 col-12"><div class="logo"><a href="/"><span>A</span>lain Cleaning</a></div></div>
        <div class="col-md-6 col-12"><nav class="nav-blog">
          <a href="/">Accueil</a>
          <a href="/#services">Services</a>
          <a href="/#contact">Contact</a>
        </nav></div>
      </div>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="container text-center" style="padding:34px 0;color:#8aa2b5;font-size:14px">
      © {{ site.name }} — Nettoyage professionnel, GTA Oshawa.
      <div style="margin-top:8px">
        <a href="mailto:{{ site.email }}" style="color:#13a5b9;text-decoration:none;font-weight:600">{{ site.email }}</a>
      </div>
    </div>
  </footer>
</body>
</html>